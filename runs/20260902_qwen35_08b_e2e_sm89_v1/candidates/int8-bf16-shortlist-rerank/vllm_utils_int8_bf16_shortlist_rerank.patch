+@triton.jit
+def _sm89_exact_bf16_shortlist_rerank_kernel(
+    x_ptr,
+    weight_ptr,
+    shortlist_indices_ptr,
+    output_ptr,
+    k: tl.constexpr,
+    BLOCK_K: tl.constexpr,
+):
+    pid = tl.program_id(0)
+    offsets_k = tl.arange(0, BLOCK_K)
+    row = tl.load(shortlist_indices_ptr + pid).to(tl.int64)
+    valid_k = offsets_k < k
+    x = tl.load(x_ptr + offsets_k, mask=valid_k, other=0.0).to(tl.float32)
+    weight = tl.load(
+        weight_ptr + row * k + offsets_k,
+        mask=valid_k,
+        other=0.0,
+    ).to(tl.float32)
+    accum = tl.sum(weight * x, axis=0)
+    tl.store(output_ptr + row, accum)
+
