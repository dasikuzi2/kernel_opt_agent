+_SM89_INT8_GROUPWISE_CACHE: dict[
+    tuple[int, int, int], tuple[torch.Tensor, torch.Tensor]
+] = {}
+
+
+def _get_sm89_int8_groupwise_weight(
+    weight: torch.Tensor, group_k: int
+) -> tuple[torch.Tensor, torch.Tensor]:
+    cache_key = (weight.data_ptr(), weight.numel(), group_k)
+    cached = _SM89_INT8_GROUPWISE_CACHE.get(cache_key)
+    if cached is not None:
+        return cached
+    n, k = weight.shape
+    blocks = weight.float().reshape(n, k // group_k, group_k)
+    scales = blocks.abs().amax(dim=2).div(127.0).clamp_min(
+        torch.finfo(torch.float32).tiny
+    )
+    qweight = (
+        torch.round(blocks / scales[:, :, None])
+        .clamp(-127, 127)
+        .to(torch.int8)
+        .reshape(n, k)
+        .contiguous()
+    )
+    cached = (qweight, scales.to(torch.float16).contiguous())
+    _SM89_INT8_GROUPWISE_CACHE[cache_key] = cached
+    packed_bytes = sum(t.numel() * t.element_size() for t in cached)
+    logger.info_once(
+        "SM89 INT8 groupwise lm_head cache ready: group=%d, %.3f MiB (%.3f of dense)",
+        group_k, packed_bytes / (1024 * 1024),
+        packed_bytes / (weight.numel() * weight.element_size()),
+    )
+    return cached
+
