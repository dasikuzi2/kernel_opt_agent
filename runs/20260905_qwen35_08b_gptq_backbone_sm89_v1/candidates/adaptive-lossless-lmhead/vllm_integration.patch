+    quantization method.
+    """
+
+    lm_head_max_packed_fraction: float = 0.90
+    """Maximum auxiliary-layout bytes divided by dense BF16 weight bytes.
+
+    Heads with worse compressibility safely remain on the stock path.
+    """
+
